<Window x:Class="ShutaNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d" Title="ShutaNote" Height="820" Width="1440"
        MinHeight="620" MinWidth="1060" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" SnapsToDevicePixels="True"
        Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="5" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#6657E8"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1C2033"/>
        <SolidColorBrush x:Key="WindowBackground" Color="#E9EDF5"/>
        <SolidColorBrush x:Key="GlassBrush" Color="#E6FFFFFF"/>
        <SolidColorBrush x:Key="GlassBrushStrong" Color="#F2FFFFFF"/>
        <SolidColorBrush x:Key="ToolbarGlassBrush" Color="#CCFFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#66CDD2DF"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#E9E7FC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7D8499"/>
        <SolidColorBrush x:Key="CanvasBrush" Color="#FAFAFC"/>
        <SolidColorBrush x:Key="GridBrush" Color="#CBD0DB"/>
        <SolidColorBrush x:Key="ViewportBrush" Color="#E4E8F1"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#6657E8"/>
        <SolidColorBrush x:Key="ActiveColorBrush" Color="#4841BD"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ToolButton" TargetType="ToggleButton"><Setter Property="MinWidth" Value="38"/><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="2"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTipService.ShowDuration" Value="5000"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBg" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="4,0"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="34"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="ComboBackground" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"><Grid><ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/><TextBlock x:Name="ComboArrow" Text="⌄" Margin="0,0,10,2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/></Grid></Border><ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,5,0,0" Padding="4" CornerRadius="6" Background="{DynamicResource GlassBrushStrong}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBackground" Property="Background" Value="{DynamicResource Primary}"/><Setter TargetName="ComboArrow" Property="Foreground" Value="White"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboBackground" Property="Background" Value="{DynamicResource Primary}"/><Setter TargetName="ComboArrow" Property="Foreground" Value="White"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
        <Style TargetType="MenuItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="MenuBg" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter ContentSource="Header"/><TextBlock Grid.Column="1" Margin="24,0,0,0" Foreground="{DynamicResource MutedBrush}" Text="{TemplateBinding InputGestureText}"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuBg" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="5,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource Primary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SideColumn" Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid x:Name="ViewportLayer" Grid.ColumnSpan="2" Panel.ZIndex="0" Background="{DynamicResource ViewportBrush}" ClipToBounds="True">
            <Grid x:Name="Viewport" Background="Transparent" ClipToBounds="True" PreviewMouseWheel="Viewport_MouseWheel" PreviewMouseDown="Viewport_MouseDown" PreviewMouseMove="Viewport_MouseMove" PreviewMouseUp="Viewport_MouseUp" MouseLeave="Viewport_MouseLeave">
                <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" CanContentScroll="False" ScrollChanged="CanvasScroll_ScrollChanged">
                    <Grid x:Name="CanvasHostGrid" Width="5000" Height="3500"><Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="{DynamicResource CanvasBrush}"><GeometryDrawing.Pen><Pen Brush="{DynamicResource GridBrush}" Thickness="0.65"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="0,0" EndPoint="24,0"/><LineGeometry StartPoint="0,0" EndPoint="0,24"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Grid.Background>
                        <Grid x:Name="GridHighlight" Width="5000" Height="3500" IsHitTestVisible="False" Visibility="Collapsed"><Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing><GeometryDrawing.Pen><Pen Brush="{DynamicResource Primary}" Thickness="1.15"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="0,0" EndPoint="24,0"/><LineGeometry StartPoint="0,0" EndPoint="0,24"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Grid.Background><Grid.OpacityMask><RadialGradientBrush x:Name="GridHighlightMask" MappingMode="RelativeToBoundingBox" RadiusX="0.024" RadiusY="0.034"><GradientStop Color="#BFFFFFFF" Offset="0"/><GradientStop Color="#62FFFFFF" Offset="0.42"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Grid.OpacityMask></Grid>
                        <InkCanvas x:Name="BoardCanvas" Width="5000" Height="3500" Background="Transparent" EditingMode="Select" SelectionChanged="BoardCanvas_SelectionChanged" StrokeCollected="BoardCanvas_StrokeCollected" PreviewMouseLeftButtonDown="BoardCanvas_MouseLeftButtonDown" PreviewMouseLeftButtonUp="BoardCanvas_MouseLeftButtonUp"><InkCanvas.ContextMenu><ContextMenu Background="{DynamicResource GlassBrushStrong}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"><MenuItem Header="复制" InputGestureText="Ctrl+C" Click="CopySelection_Click"/><MenuItem Header="粘贴" InputGestureText="Ctrl+V" Click="Paste_Click"/><Separator/><MenuItem Header="全选" InputGestureText="Ctrl+A" Click="SelectAll_Click"/><MenuItem Header="删除" InputGestureText="Delete" Click="DeleteSelection_Click"/></ContextMenu></InkCanvas.ContextMenu></InkCanvas>
                    </Grid>
                </ScrollViewer>
                <Rectangle x:Name="SelectionMarquee" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="60" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource SelectionBrush}" StrokeThickness="1.25" StrokeDashArray="4,3" Fill="Transparent"/><Rectangle x:Name="SelectedElementOutline" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="65" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource SelectionBrush}" StrokeThickness="2" Fill="Transparent"/>
                <Canvas x:Name="ResizeOverlay" Visibility="Collapsed" Panel.ZIndex="69"><Ellipse x:Name="ResizeTopLeft" Tag="TopLeft" Width="14" Height="14" Stroke="{DynamicResource SelectionBrush}" StrokeThickness="2" Fill="{DynamicResource CanvasBrush}" Cursor="SizeNWSE" PreviewMouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"/><Ellipse x:Name="ResizeTopRight" Tag="TopRight" Width="14" Height="14" Stroke="{DynamicResource SelectionBrush}" StrokeThickness="2" Fill="{DynamicResource CanvasBrush}" Cursor="SizeNESW" PreviewMouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"/><Ellipse x:Name="ResizeBottomLeft" Tag="BottomLeft" Width="14" Height="14" Stroke="{DynamicResource SelectionBrush}" StrokeThickness="2" Fill="{DynamicResource CanvasBrush}" Cursor="SizeNESW" PreviewMouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"/><Ellipse x:Name="ResizeBottomRight" Tag="BottomRight" Width="14" Height="14" Stroke="{DynamicResource SelectionBrush}" StrokeThickness="2" Fill="{DynamicResource CanvasBrush}" Cursor="SizeNWSE" PreviewMouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"/></Canvas>
                <Canvas x:Name="RotationOverlay" Visibility="Collapsed" Panel.ZIndex="70"><Line x:Name="RotationGuide" Stroke="{DynamicResource SelectionBrush}" StrokeThickness="1.25" StrokeDashArray="3,2" IsHitTestVisible="False"/><Ellipse x:Name="RotationHandle" Width="18" Height="18" Stroke="{DynamicResource SelectionBrush}" StrokeThickness="2" Fill="{DynamicResource CanvasBrush}" Cursor="Hand" ToolTip="拖动进行全向旋转" PreviewMouseLeftButtonDown="RotationHandle_MouseLeftButtonDown"/></Canvas>
            </Grid>
        </Grid>
        <Border x:Name="GpuDiagnosticsOverlay" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,7" CornerRadius="4" Background="#D0202430" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="80"><TextBlock x:Name="GpuDiagnosticsText" Foreground="White" FontFamily="Consolas" FontSize="12"/></Border>
        <Border x:Name="SideGlass" Grid.Column="0" Panel.ZIndex="10" Margin="8" CornerRadius="6" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
                <Grid Margin="18,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" CornerRadius="6" Background="{StaticResource Primary}"><TextBlock Text="S" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="ShutaNote" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><Button Content="‹" HorizontalAlignment="Right" ToolTip="收起白板列表" Click="ToggleSidebar_Click"/></Grid>
                <Button Grid.Row="1" Margin="12,8" Padding="12,9" Background="{StaticResource Primary}" Foreground="White" HorizontalContentAlignment="Left" Click="NewBoard_Click"><TextBlock Text="＋  新建白板" FontWeight="SemiBold"/></Button>
                <ListBox x:Name="BoardList" Grid.Row="2" Margin="7" SelectionChanged="BoardList_SelectionChanged" DisplayMemberPath="Name"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="✎ 重命名" Click="RenameBoard_Click"/><Button Content="⌫ 删除" Foreground="#DC5263" Click="DeleteBoard_Click"/></StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainArea" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
            <Border x:Name="HeaderGlass" Panel.ZIndex="10" Margin="0,8,8,4" CornerRadius="5" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="15,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button x:Name="ExpandSidebarButton" Content="☰" Visibility="Collapsed" ToolTip="展开白板列表" Click="ToggleSidebar_Click"/><TextBox x:Name="TitleBox" Foreground="{DynamicResource TextBrush}" Width="260" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" LostFocus="TitleBox_LostFocus"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="SaveStatus" Text="已保存" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="导入图片" Click="ImportImage_Click"/><Button Content="导出 PNG" Background="{DynamicResource HoverBrush}" Foreground="{DynamicResource Primary}" Click="ExportPng_Click"/><Button Content="⚙" ToolTip="设置" Click="Settings_Click"/><Button x:Name="PinButton" Content="⌖" ToolTip="置顶" Click="Pin_Click"/><Button Content="◫" ToolTip="专注白板 (F11)" Click="FocusMode_Click"/><Button Width="34" Content="—" ToolTip="最小化" Click="Minimize_Click"/><Button x:Name="MaximizeButton" Width="34" Content="□" ToolTip="最大化" Click="Maximize_Click"/><Button Width="34" Content="✕" ToolTip="关闭" Click="Close_Click"/></StackPanel></Grid></Border>

            <Border x:Name="ToolbarGlass" Grid.Row="1" Panel.ZIndex="10" Margin="0,4,8,6" CornerRadius="8" Background="{DynamicResource ToolbarGlassBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#F2FFFFFF" Offset="0.5"/><GradientStop Color="#D8FFFFFF" Offset="1"/></LinearGradientBrush></Border.OpacityMask>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalContentAlignment="Center"><StackPanel Orientation="Horizontal" Margin="12,5">
                <ToggleButton Style="{StaticResource ToolButton}" ToolTip="自由画笔 (P)" Tag="Pen" Click="Tool_Click"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="17"/></ToggleButton>
                <ToggleButton Style="{StaticResource ToolButton}" ToolTip="添加文字 (T)" Tag="Text" Click="Tool_Click"><TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="17"/></ToggleButton>
                <Separator Margin="6,2"/>
                <ToggleButton Style="{StaticResource ToolButton}" ToolTip="矩形 (R)" Tag="Rectangle" Click="Tool_Click"><TextBlock Text="&#xE7B0;" FontFamily="Segoe MDL2 Assets" FontSize="17"/></ToggleButton>
                <ToggleButton Style="{StaticResource ToolButton}" ToolTip="椭圆 (O)" Tag="Ellipse" Click="Tool_Click"><TextBlock Text="&#xE7B1;" FontFamily="Segoe MDL2 Assets" FontSize="17"/></ToggleButton>
                <ToggleButton Style="{StaticResource ToolButton}" ToolTip="箭头 (A)" Tag="Arrow" Click="Tool_Click"><TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="17"/></ToggleButton>
                <Separator Margin="6,2"/>
                <ComboBox x:Name="FontFamilyBox" Width="125" SelectionChanged="FontFamilyBox_SelectionChanged"><ComboBoxItem Content="微软雅黑" IsSelected="True"/><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="宋体"/><ComboBoxItem Content="等线"/><ComboBoxItem Content="Consolas"/></ComboBox>
                <ComboBox x:Name="FontSizeBox" Width="72" SelectedIndex="3" SelectionChanged="FontSizeBox_SelectionChanged"><ComboBoxItem Content="12"/><ComboBoxItem Content="14"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="24"/><ComboBoxItem Content="32"/><ComboBoxItem Content="48"/></ComboBox>
                <Button Content="B" FontWeight="Bold" ToolTip="粗体" Click="Bold_Click"/><Button Content="I" FontStyle="Italic" ToolTip="斜体" Click="Italic_Click"/><Button ToolTip="下划线" Click="Underline_Click"><TextBlock Text="U" TextDecorations="Underline"/></Button>
                <Button x:Name="ColorButton" ToolTip="打开全色取色器" Click="Color_Click"><Border Width="17" Height="17" CornerRadius="2" Background="{DynamicResource ActiveColorBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/></Button>
                <Separator Margin="6,2"/><Button ToolTip="撤销 (Ctrl+Z)" Click="Undo_Click"><TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button><Button ToolTip="重做 (Ctrl+Y)" Click="Redo_Click"><TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button><Button Foreground="#DC5263" ToolTip="删除所选 (Delete)" Click="DeleteSelection_Click"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
                </StackPanel></ScrollViewer>
            </Border>

            <Border x:Name="StatusGlass" Grid.Row="3" Panel.ZIndex="10" Margin="0,3,8,7" CornerRadius="6" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Grid Margin="14,0"><TextBlock x:Name="HintText" Text="选择工具 · 拖动对象，滚轮缩放，空格拖动画布" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="−" Padding="7,1" Click="ZoomOut_Click"/><TextBlock x:Name="ZoomText" Text="100%" Width="50" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="＋" Padding="7,1" Click="ZoomIn_Click"/><Button Content="适应" Padding="7,1" Click="Fit_Click"/></StackPanel></Grid></Border>

            <Border x:Name="FocusToolbar" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="50" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="7,5" CornerRadius="6" Background="{DynamicResource GlassBrushStrong}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal"><ToggleButton Style="{StaticResource ToolButton}" ToolTip="画笔 (P)" Tag="Pen" Click="Tool_Click"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"/></ToggleButton><ToggleButton Style="{StaticResource ToolButton}" ToolTip="文字 (T)" Tag="Text" Click="Tool_Click"><TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets"/></ToggleButton><ToggleButton Style="{StaticResource ToolButton}" ToolTip="矩形 (R)" Tag="Rectangle" Click="Tool_Click"><TextBlock Text="&#xE7B0;" FontFamily="Segoe MDL2 Assets"/></ToggleButton><Button x:Name="FocusPinButton" ToolTip="置顶" Click="Pin_Click"><TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets"/></Button><Button ToolTip="缩小" Click="ZoomOut_Click"><TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets"/></Button><TextBlock x:Name="FocusZoomText" Text="100%" Width="48" TextAlignment="Center" VerticalAlignment="Center"/><Button ToolTip="放大" Click="ZoomIn_Click"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"/></Button><Button Content="退出" ToolTip="退出专注模式 (F11)" Click="FocusMode_Click"/></StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ColorPaletteOverlay" Grid.ColumnSpan="2" Background="#55000000" Visibility="Collapsed" Panel.ZIndex="90" MouseDown="ColorPaletteOverlay_MouseDown">
            <Border x:Name="ColorPaletteCard" Width="680" Padding="24" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource GlassBrushStrong}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MouseDown="ColorPaletteCard_MouseDown">
                <StackPanel><Grid Margin="0,0,0,18"><TextBlock Text="全色取色器" FontSize="20" FontWeight="SemiBold"/><Button Content="✕" HorizontalAlignment="Right" Click="CloseColorPalette_Click"/></Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid x:Name="ColorField" Height="300" Cursor="Cross" ClipToBounds="True" MouseLeftButtonDown="ColorField_MouseLeftButtonDown" MouseMove="ColorField_MouseMove" MouseLeftButtonUp="ColorField_MouseLeftButtonUp"><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop x:Name="HueColorStop" Color="Red" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FF000000" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Ellipse x:Name="ColorFieldPointer" Width="16" Height="16" Stroke="White" StrokeThickness="2" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/></Grid>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RGB" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="R" VerticalAlignment="Center"/><Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="RgbSlider_ValueChanged"/><TextBlock x:Name="RedValueText" Grid.Column="2" Text="0" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="G" VerticalAlignment="Center"/><Slider x:Name="GreenSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="RgbSlider_ValueChanged"/><TextBlock x:Name="GreenValueText" Grid.Column="2" Text="0" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="B" VerticalAlignment="Center"/><Slider x:Name="BlueSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="RgbSlider_ValueChanged"/><TextBlock x:Name="BlueValueText" Grid.Column="2" Text="0" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <TextBlock Text="HSV" FontWeight="SemiBold" Margin="0,14,0,6"/>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="H" VerticalAlignment="Center"/><Slider x:Name="HueSlider" Grid.Column="1" Minimum="0" Maximum="360" ValueChanged="HsvSlider_ValueChanged"/><TextBlock x:Name="HueValueText" Grid.Column="2" Text="0°" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="S" VerticalAlignment="Center"/><Slider x:Name="SaturationSlider" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="HsvSlider_ValueChanged"/><TextBlock x:Name="SaturationValueText" Grid.Column="2" Text="0%" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="V" VerticalAlignment="Center"/><Slider x:Name="ValueSlider" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="HsvSlider_ValueChanged"/><TextBlock x:Name="ValueValueText" Grid.Column="2" Text="0%" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="ColorPreview" Width="42" Height="42" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/><TextBlock x:Name="ColorHexText" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="16"/><Button Grid.Column="2" Content="完成" Background="{DynamicResource Primary}" Foreground="White" Click="CloseColorPalette_Click"/></Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#66000000" Visibility="Collapsed" Panel.ZIndex="100" MouseDown="SettingsOverlay_MouseDown">
            <Border x:Name="SettingsCard" Width="410" Margin="12" Padding="26" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="{DynamicResource GlassBrushStrong}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MouseDown="SettingsCard_MouseDown">
                <StackPanel>
                    <Grid Margin="0,0,0,26"><TextBlock Text="外观设置" FontSize="22" FontWeight="SemiBold"/><Button Content="✕" HorizontalAlignment="Right" Click="CloseSettings_Click"/></Grid>
                    <TextBlock Text="显示模式" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24"><RadioButton x:Name="LightModeRadio" Content="☀  浅色" GroupName="Theme" Margin="0,0,24,0" Checked="ThemeMode_Checked"/><RadioButton x:Name="DarkModeRadio" Content="☾  深色" GroupName="Theme" Checked="ThemeMode_Checked"/></StackPanel>
                    <TextBlock Text="主题配色" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Button Margin="0,0,0,24" Padding="12,10" HorizontalContentAlignment="Stretch" Background="{DynamicResource HoverBrush}" Click="ThemePalette_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource Primary}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="自定义主题色" FontWeight="SemiBold"/><TextBlock Text="从完整调色板中选择" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel><TextBlock Grid.Column="2" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></Grid>
                    </Button>
                    <Grid Margin="0,0,0,8"><TextBlock Text="前景玻璃不透明度" FontWeight="SemiBold"/><TextBlock x:Name="OpacityValueText" Text="90%" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid>
                    <Slider x:Name="GlassOpacitySlider" Minimum="35" Maximum="300" Value="90" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="GlassOpacitySlider_ValueChanged"/>
                    <Grid Margin="0,20,0,8"><TextBlock Text="主页玻璃模糊度" FontWeight="SemiBold"/><TextBlock x:Name="GlassBlurValueText" Text="18" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid>
                    <Slider x:Name="GlassBlurSlider" Minimum="0" Maximum="120" Value="18" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="GlassBlurSlider_ValueChanged"/>
                    <TextBlock Text="GPU 画布" FontWeight="SemiBold" Margin="0,24,0,10"/>
                    <CheckBox x:Name="GpuCanvasCheckBox" Content="启用 GPU 画布（初始化失败时自动回退）" Checked="GpuCanvasCheckBox_Changed" Unchecked="GpuCanvasCheckBox_Changed"/>
                    <CheckBox x:Name="GpuFallbackCheckBox" Content="允许软件画布回退" Margin="0,8,0,0" Checked="GpuFallbackCheckBox_Changed" Unchecked="GpuFallbackCheckBox_Changed"/>
                    <CheckBox x:Name="GpuDiagnosticsCheckBox" Content="显示 GPU 诊断信息" Margin="0,8,0,0" Checked="GpuDiagnosticsCheckBox_Changed" Unchecked="GpuDiagnosticsCheckBox_Changed"/>
                    <TextBlock Text="调整侧栏、标题栏、工具栏和状态栏的半透明材质。Windows 11 下会透出系统云母背景。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" LineHeight="20"/>
                    <Border Margin="0,28,0,0" Padding="14" CornerRadius="6" Background="{DynamicResource HoverBrush}"><TextBlock Text="提示：鼠标附近会显示低强度、边缘羽化的主题色圆形网格光晕。" TextWrapping="Wrap"/></Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="DialogOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#73000000" Visibility="Collapsed" Panel.ZIndex="200">
            <Border x:Name="MessageDialog" Width="430" Padding="24" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource GlassBrushStrong}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Visibility="Collapsed">
                <StackPanel><TextBlock x:Name="DialogTitle" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DialogMessage" Margin="0,14,0,22" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" LineHeight="21"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="DialogCancelButton" Content="取消" MinWidth="76" Click="DialogCancel_Click"/><Button Content="确定" MinWidth="76" Background="{DynamicResource Primary}" Foreground="White" Click="DialogConfirm_Click"/></StackPanel></StackPanel>
            </Border>
            <Border x:Name="FileDialog" Width="760" Height="540" Padding="22" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource GlassBrushStrong}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Visibility="Collapsed">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><TextBlock x:Name="FileDialogTitle" Text="选择文件" FontSize="20" FontWeight="SemiBold"/><Button Content="✕" HorizontalAlignment="Right" Click="FileDialogCancel_Click"/></Grid>
                    <Grid Grid.Row="1" Margin="0,18,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="↑ 上一级" Click="FileUp_Click"/><TextBox x:Name="FilePathBox" Grid.Column="1" Margin="8,0" Padding="10,7" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource HoverBrush}" BorderThickness="0" KeyDown="FilePathBox_KeyDown"/><Button Grid.Column="2" Content="转到" Click="FileGo_Click"/></Grid>
                    <ListBox x:Name="FileItemsList" Grid.Row="2" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" MouseDoubleClick="FileItemsList_MouseDoubleClick"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" Foreground="{DynamicResource TextBrush}" FontSize="18"/><TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FileNameBox" Padding="10,7" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource HoverBrush}" BorderThickness="0"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"><Button Content="取消" MinWidth="76" Click="FileDialogCancel_Click"/><Button x:Name="FileAcceptButton" Content="选择" MinWidth="76" Background="{DynamicResource Primary}" Foreground="White" Click="FileDialogAccept_Click"/></StackPanel></Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
